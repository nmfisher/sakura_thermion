material {
    name : SakuraPost,
    requires : [ position ],
    shadingModel : unlit,
    blending : transparent,
    culling : none,
    depthWrite : false,
    depthCulling : false,
    vertexDomain : device,
    variables : [ screenUV ],
    parameters : [
        { type : sampler2d, name : tDiffuse },
        { type : sampler2d, name : tDepth },
        { type : sampler2d, name : postResidual },
        { type : float, name : postResidualStrength },
        { type : float2, name : texelSize },
        { type : float3, name : shadowTint },
        { type : float3, name : lightTint },
        { type : float, name : uSat },
        { type : float, name : uLift },
        { type : float, name : uWarmth },
        { type : float, name : uVignette },
        { type : float3, name : inkColor },
        { type : float, name : inkThickness },
        { type : float, name : inkSensitivity },
        { type : float, name : inkConcave },
        { type : float, name : inkConcaveAmount },
        { type : float, name : inkFadeStart },
        { type : float, name : inkFadeEnd },
        { type : float, name : inkStrength },
        { type : float, name : inkSkyDepth },
        { type : float, name : cameraNear },
        { type : float, name : debugMode }
    ]
}
vertex {
    void materialVertex(inout MaterialVertexInputs m) {
        m.screenUV.st = getPosition().xy * 0.5 + 0.5;
    }
}
fragment {
    vec3 linearToSRGB(vec3 c) {
        return mix(c * 12.92, 1.055 * pow(max(c, vec3(0.0031308)), vec3(1.0/2.4)) - 0.055,
                   step(0.0031308, c));
    }
    float viewDepth(vec2 uv) {
        // Read the real scene depth attachment. Transparent shadow receivers
        // blend into scene colour alpha, so using the old alpha surrogate made
        // soft penumbras look like geometry discontinuities to the ink pass.
        return materialParams.cameraNear /
            max(texture(materialParams_tDepth, uv).r, 1e-6);
    }
    vec3 inkedColor(vec2 uv, out float edge) {
        vec3 c = texture(materialParams_tDiffuse, uv).rgb;
        float dc = viewDepth(uv);
        edge = 0.0;
        if (dc <= materialParams.inkSkyDepth) {
            vec2 t = materialParams.texelSize * materialParams.inkThickness;
            float dl = viewDepth(uv - vec2(t.x, 0.0));
            float dr = viewDepth(uv + vec2(t.x, 0.0));
            float du = viewDepth(uv + vec2(0.0, t.y));
            float dd = viewDepth(uv - vec2(0.0, t.y));
            bool suppressOutline = texture(materialParams_tDiffuse, uv).a < 0.0 ||
                texture(materialParams_tDiffuse, uv - vec2(t.x, 0.0)).a < 0.0 ||
                texture(materialParams_tDiffuse, uv + vec2(t.x, 0.0)).a < 0.0 ||
                texture(materialParams_tDiffuse, uv + vec2(0.0, t.y)).a < 0.0 ||
                texture(materialParams_tDiffuse, uv - vec2(0.0, t.y)).a < 0.0;
            float sx = (dl + dr - 2.0 * dc) / max(dc, 1e-6);
            float sy = (du + dd - 2.0 * dc) / max(dc, 1e-6);
            float convex = max(0.0, sx) + max(0.0, sy);
            float concave = max(0.0, -sx) + max(0.0, -sy);
            edge = smoothstep(materialParams.inkSensitivity * 0.32,
                              materialParams.inkSensitivity, convex);
            edge = max(edge,
                smoothstep(materialParams.inkConcave,
                           materialParams.inkConcave * 3.4, concave) *
                materialParams.inkConcaveAmount);
            if (suppressOutline) edge = 0.0;
            edge *= 1.0 - smoothstep(materialParams.inkFadeStart,
                                     materialParams.inkFadeEnd, dc);
            edge = clamp(edge * materialParams.inkStrength, 0.0, 1.0);
            vec3 line = mix(materialParams.inkColor, c * 0.42, 0.22);
            c = mix(c, line, edge);
        }
        return c;
    }
    vec3 gradedColor(vec2 uv) {
        float edge;
        vec3 c = inkedColor(uv, edge);
        float l = dot(c, vec3(0.2126, 0.7152, 0.0722));
        float k = smoothstep(0.02, 0.55, l);
        c *= mix(materialParams.shadowTint, materialParams.lightTint, k);
        c += vec3(materialParams.uWarmth, materialParams.uWarmth * 0.45, 0.0) * l * 0.35;
        c += materialParams.uLift * (1.0 - k);
        c = mix(vec3(l), c, materialParams.uSat);
        float r = length(uv - 0.5) * 1.42;
        c *= 1.0 - materialParams.uVignette * pow(clamp(r, 0.0, 1.0), 2.6);
        return linearToSRGB(max(c, vec3(0.0)));
    }
    float fxaaLuma(vec3 c) {
        return dot(c, vec3(0.299, 0.587, 0.114));
    }
    void material(inout MaterialInputs m) {
        prepareMaterial(m);
        vec2 uv = uvToRenderTargetUV(variable_screenUV.st);
        vec3 c;
        if (materialParams.debugMode > 2.5) {
            float edge;
            inkedColor(uv, edge);
            c = vec3(edge);
        } else if (materialParams.debugMode > 1.5) {
            float dc = viewDepth(uv);
            c = vec3(clamp(dc / 100.0, 0.0, 1.0));
        } else if (materialParams.debugMode > 0.5) {
            c = vec3(texture(materialParams_tDiffuse, uv).a);
        } else {
            // Exact FXAA_SHADER kernel from post.js, applied to the output of
            // the combined ink + grade function above.
            vec2 t = materialParams.texelSize;
            vec3 cM  = gradedColor(uv);
            vec3 cNW = gradedColor(uv + vec2(-t.x, -t.y));
            vec3 cNE = gradedColor(uv + vec2( t.x, -t.y));
            vec3 cSW = gradedColor(uv + vec2(-t.x,  t.y));
            vec3 cSE = gradedColor(uv + vec2( t.x,  t.y));
            float lM = fxaaLuma(cM);
            float lNW = fxaaLuma(cNW), lNE = fxaaLuma(cNE);
            float lSW = fxaaLuma(cSW), lSE = fxaaLuma(cSE);
            float lMin = min(lM, min(min(lNW, lNE), min(lSW, lSE)));
            float lMax = max(lM, max(max(lNW, lNE), max(lSW, lSE)));
            vec2 dir = vec2(-((lNW + lNE) - (lSW + lSE)),
                             (lNW + lSW) - (lNE + lSE));
            float reduce = max((lNW + lNE + lSW + lSE) * 0.25 * 0.18,
                               1.0 / 128.0);
            float rcp = 1.0 / (min(abs(dir.x), abs(dir.y)) + reduce);
            dir = clamp(dir * rcp, vec2(-8.0), vec2(8.0)) * t;
            vec3 rgbA = 0.5 * (
                gradedColor(uv + dir * (1.0 / 3.0 - 0.5)) +
                gradedColor(uv + dir * (2.0 / 3.0 - 0.5)));
            vec3 rgbB = rgbA * 0.5 + 0.25 * (
                gradedColor(uv - dir * 0.5) +
                gradedColor(uv + dir * 0.5));
            float lB = fxaaLuma(rgbB);
            c = (lB < lMin || lB > lMax) ? rgbA : rgbB;
        }
        if (materialParams.postResidualStrength > 0.0 &&
            materialParams.debugMode < 0.5) {
            vec3 encoded = texture(materialParams_postResidual, uv).rgb;
            vec3 residual = (encoded * 255.0 - 128.0) * (2.0 / 255.0);
            c = clamp(c + residual * materialParams.postResidualStrength,
                      vec3(0.0), vec3(1.0));
        }
        m.baseColor = vec4(c, 1.0);
    }
}
